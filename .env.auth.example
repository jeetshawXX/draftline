# Public canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://YOUR-DOMAIN"

# Session signing secret: use a random value of at least 32 characters
AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth 2.0 web client
GOOGLE_CLIENT_ID=""
